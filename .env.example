# Compatibilidade com conexões Blob antigas. Conexões novas usam OIDC e criam
# BLOB_STORE_ID/BLOB_WEBHOOK_PUBLIC_KEY automaticamente na Vercel.
BLOB_READ_WRITE_TOKEN=

# Credenciais do painel em /admin.
ADMIN_EMAIL=malagoligrowth@gmail.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Use uma sequência aleatória com pelo menos 32 caracteres.
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Recomendado: segredo estável e exclusivo para criptografar os dados dos clientes.
# Não altere depois que houver pedidos sem antes migrar os registros existentes.
CUSTOMER_DATA_SECRET=troque-por-outro-segredo-longo-e-aleatorio
